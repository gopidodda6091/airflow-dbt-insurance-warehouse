# Copy to .env. Placeholders only - never commit real credentials.
DBT_TARGET=duckdb
DUCKDB_PATH=data/warehouse.duckdb
RAW_SCHEMA=raw

# snowflake target (template)
SNOWFLAKE_ACCOUNT=<account-locator>
SNOWFLAKE_USER=<user>
SNOWFLAKE_PASSWORD=<password-placeholder>
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORMING
SNOWFLAKE_DATABASE=LONE_STAR
SNOWFLAKE_SCHEMA=ANALYTICS

# redshift target (template)
REDSHIFT_HOST=<cluster>.<region>.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_USER=<user>
REDSHIFT_PASSWORD=<password-placeholder>
REDSHIFT_DATABASE=lone_star
REDSHIFT_SCHEMA=analytics
